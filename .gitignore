# Rust 编译产物
/target/

# 打包输出（正式 exe + zip，体积大且可由 pack_release.ps1 重新生成）
/dist/

# Cargo 锁文件（库项目不提交，应用项目可提交）
# Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 设计文件（不上传到仓库）
ui-design*.html

# 调试文件
*.pdb

# 运行/构建日志
*.log

# 第三方参考源码（UnityCapture 官方包解压产物）：新机器 cargo build 一行都用不到
# —— 没有 build.rs，也没有任何 C++ 参与编译，共享内存协议是照 shared.inl 手写的。
# 按「构建不需要的文件不入库」原则不再跟踪，只留在本地磁盘。
# 注意：本机注册的虚拟摄像头滤镜 DLL 就指向这个目录（HKLM CLSID\{5C2CD55C-…}\InprocServer32），
# 所以只能取消跟踪，不能删文件——删了 DirectShow 会找不到滤镜，摄像头设备直接消失。
third_party/

# graphify 知识图谱产物（本地生成物，可由 graphify extract 重新生成，不入库）
/graphify-out/
/graphify-out-src/
